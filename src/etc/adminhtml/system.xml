<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="reach_digital_config" translate="label" sortOrder="10">
            <label>Reach Digital</label>
        </tab>
        <section id="improved_api" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Improved api</label>
            <tab>reach_digital_config</tab>
            <resource>ReachDigital_Api::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable quick product update</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Note: This uses the action updateAttributes and the StockRegistry
                        instead of the product repository to update products faster but might give issues when using msi
                        and won't work with certain changes like media_gallery or linked_products.</comment>
                </field>

            </group>
        </section>
    </system>
</config>
